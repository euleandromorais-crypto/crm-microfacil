# ============================================================
# CRM Comercial — configuração do servidor
# Copie para server/.env e preencha. NUNCA versione o .env real.
# ============================================================
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# URL pública (usada em links de redefinição de senha e nas URLs de webhook exibidas)
APP_URL=https://crm.seudominio.com.br

# PostgreSQL
DATABASE_URL=postgres://crm:SENHA_FORTE@127.0.0.1:5432/crm
DATABASE_POOL_MAX=15

# Chave de criptografia das credenciais de integração (32 bytes em hex).
# Gere com: openssl rand -hex 32   — guarde com segurança: sem ela as credenciais salvas não podem ser lidas.
APP_ENCRYPTION_KEY=

# Sessão / cookies (atrás do Nginx com HTTPS)
SESSION_TTL_HOURS=12
COOKIE_SECURE=true
TRUST_PROXY=true

# Arquivos de mídia do WhatsApp
STORAGE_DIR=/var/lib/crm/storage
MAX_UPLOAD_MB=16

# true = fila de jobs dentro do processo da API; false = rodar "npm run worker" separado (recomendado com PM2)
RUN_WORKER_IN_PROCESS=false

LOG_LEVEL=info

# Graph API da Meta
META_GRAPH_VERSION=v23.0
META_GRAPH_URL=https://graph.facebook.com

# E-mail (recuperação de senha). Opcional: sem SMTP, o administrador gera o link de redefinição.
# Hostinger Email: smtp.hostinger.com, porta 465 (SSL)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CRM <crm@seudominio.com.br>"

TZ_APP=America/Sao_Paulo
